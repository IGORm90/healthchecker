# Путь к SQLite внутри контейнера backend (значение по умолчанию):
# DATABASE_URL=sqlite+aiosqlite:////data/app.db

# Разрешить Мониторам приватные сети (10/8, 172.16/12, 192.168/16, fc00::/7):
# ALLOW_PRIVATE_TARGETS=false

# Вход через Telegram OpenID Connect: @BotFather → бот → Login Widget.
# Client ID — это ID бота; секрет попадает только в контейнер backend.
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=
# Должен побайтово совпадать с redirect URI, зарегистрированным в @BotFather.
TELEGRAM_REDIRECT_URI=https://example.com/auth/callback

# Telegram ID Пользователя, который при входе получает права Суперадмина.
SUPERADMIN_TELEGRAM_ID=

# Публичный адрес frontend (docker-compose); для входа через Telegram — https.
# ORIGIN=http://localhost:3000
